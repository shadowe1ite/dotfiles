Host *
      AddKeysToAgent yes

Host monitor
      #Hostname server.{{ .domain }}
      #ProxyCommand cloudflared access ssh --hostname %h
      HostName monitor
      User elite

Host bugs
      #Hostname bugs.{{ .domain }}
      #ProxyCommand cloudflared access ssh --hostname %h
      HostName bugs
      User bugs

#Host pi
#      Hostname pi.{{ .domain }}
#      ProxyCommand cloudflared access ssh --hostname %h
#      User {{ .user }}

Host pi.local
      Hostname 192.168.1.154
      User {{ .user }}

Host pizero
      HostName 192.168.1.154
      User {{ .user }}
      IdentityFile ~/.ssh/id_ed25519_pizero

Host main
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_main

Host gitlab
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/id_ed25519_gitlab

Host alan alan.tharavad.xyz
  HostName alan.tharavad.xyz
  User alan
  IdentityFile ~/.ssh/id_ed25519_main
  IdentitiesOnly yes

# mothership VM over my own tailnet (direct, skips the edge bastion)
Host neo
  User alan
  IdentityFile ~/.ssh/id_ed25519_main
  IdentitiesOnly yes

# VNC to the VM's Interceptor browser: `ssh neo-vnc`, then VNC to localhost:5901
Host neo-vnc
  HostName neo
  User alan
  IdentityFile ~/.ssh/id_ed25519_main
  IdentitiesOnly yes
  LocalForward 5901 localhost:5901
  ExitOnForwardFailure yes
