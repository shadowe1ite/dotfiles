export PATH=$PATH:/home/shadow/.spicetify
export PATH=/home/shadow/.pdtm/go/bin:$PATH
export PATH=/home/shadow/go/bin:$PATH
export PATH=$HOME/.cargo/bin:$PATH

# Golang environment variables
export GOROOT=/usr/lib/go
export PATH=$PATH:$GOROOT/bin
export PATH=$GOPATH/bin:$GOROOT/bin:$HOME/.local/bin:$PATH

export PATH=$PATH:$HOME/.local/bin
export PATH=$PATH:$HOME/.local/bin/.stew

export PATH=$PATH:/sbin:/usr/sbin

ZSH_AUTOSUGGEST_MANUAL_REBIND=1
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)
# ZimFW init
export ZIM_HOME="$HOME/.zim"

# Auto-install ZimFW if missing
if [[ ! -f "$ZIM_HOME/zimfw.zsh" ]]; then
  mkdir -p "$ZIM_HOME"
  curl -fsSL https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh \
    -o "$ZIM_HOME/zimfw.zsh"
fi

# Build init.zsh if missing/outdated
if [[ ! -f "$ZIM_HOME/init.zsh" ]]; then
  source "$ZIM_HOME/zimfw.zsh" init
fi

# Load Zim
source "$ZIM_HOME/init.zsh"

# Shell integrations
eval "$(starship init zsh)"
eval "$(fzf --zsh)"
eval "$(zoxide init --cmd cd zsh)"

# Keybindings
bindkey -e
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey "^[[1;5C" forward-word
bindkey "^[[1;5D" backward-word
bindkey '^[w' kill-region
for key ('^[[A' '^P' ${terminfo[kcuu1]}) bindkey ${key} history-substring-search-up
for key ('^[[B' '^N' ${terminfo[kcud1]}) bindkey ${key} history-substring-search-down
for key ('k') bindkey -M vicmd ${key} history-substring-search-up
for key ('j') bindkey -M vicmd ${key} history-substring-search-down
unset key

# HISTORY
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# Completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ":completion:*:commands" rehash 1
zstyle ':completion:*:descriptions' format ''
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'ls --color $realpath'

