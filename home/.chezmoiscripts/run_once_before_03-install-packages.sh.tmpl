#!/usr/bin/env bash
set -euo pipefail
trap 'exit 130' INT
{{ template "utils" . }}

{{- define "flat" -}}
  {{- range $k, $v := . }}{{- range $v }}"{{ . }}" {{ end }}{{- end -}}
{{- end }}

sudoKeepAlive
notify "📦 Package installation started..."

retry "Database sync" $AUR -Syy --noconfirm --sudoloop \
  || warn "Database sync failed; continuing with the cached database"

installPkg "Base"     {{ template "flat" (include ".chezmoidata/packages/linux/arch/base.yaml"      | fromYaml) }}
installPkg "Nvidia"   {{ template "flat" (include ".chezmoidata/packages/linux/arch/nvidia.yaml"    | fromYaml) }}
installPkg "Desktop" {{ template "flat" (include ".chezmoidata/packages/linux/arch/desktop.yaml" | fromYaml) }}
installPkg "User Applications" {{ template "flat" (include ".chezmoidata/packages/linux/arch/applications.yaml" | fromYaml) }}

{{ if .packages.editing -}}
installPkg "Editing" {{ template "flat" (include ".chezmoidata/packages/linux/arch/editing.yaml" | fromYaml) }}
{{ else -}}
skipPkg "Editing"
{{ end -}}

{{ if .packages.games -}}
installPkg "Games" {{ template "flat" (include ".chezmoidata/packages/linux/arch/games.yaml" | fromYaml) }}
{{ else -}}
skipPkg "Games"
{{ end -}}

printSummary
if [[ ${#failed[@]} -gt 0 ]]; then
  notify "🚨 ${#failed[@]} packages failed to install"
fi

notify "✅ Package Installation Finished."
ok "All done."
