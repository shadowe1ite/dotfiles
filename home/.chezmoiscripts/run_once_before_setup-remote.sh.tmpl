#!/usr/bin/env bash
set -euo pipefail
{{- define "flat" -}}
  {{- range . }}"{{ . }}" {{ end -}}
{{- end }}

if ! command -v sudo >/dev/null 2>&1; then
    apt update -y
    apt install -y sudo
fi

normal_user=$(awk -F: '($3>=1000)&&($3<60000)&&($7 !~ /(nologin|false)/){print $1; exit}' /etc/passwd || true)

if [ -z "$normal_user" ]; then
    new_user="{{ .user }}"
    adduser --force-badname --disabled-password --gecos "" "$new_user"
    usermod -aG sudo "$new_user"

    gen_pass=$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 16)
    echo "${new_user}:${gen_pass}" | chpasswd
    echo "${gen_pass}" > /root/user_password.txt
    chmod 600 /root/user_password.txt

    normal_user="$new_user"
fi

mem_total_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
mem_total_gb=$(( (mem_total_kb + 1048575) / 1048576 ))
swap_size_gb=$((mem_total_gb * 2))
[ "$swap_size_gb" -lt 2 ] && swap_size_gb=2
[ "$swap_size_gb" -gt 8 ] && swap_size_gb=8

if ! swapon --show | grep -q .; then
    sudo fallocate -l "${swap_size_gb}G" /swapfile
    sudo chmod 600 /swapfile
    sudo mkswap /swapfile
    sudo swapon /swapfile
    echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab
fi

sudo apt update -y

{{ if eq .chezmoi.osRelease.id "ubuntu" }}
sudo apt install -y {{ template "flat" (include ".chezmoidata/packages/linux/ubuntu/ubuntu.yaml" | fromYaml).packages }}
{{ else if eq .chezmoi.osRelease.id "raspbian" }}
sudo apt install -y {{ template "flat" (include ".chezmoidata/packages/linux/rasbian/rasbian.yaml" | fromYaml).packages }}
{{ end }}

sudo usermod -aG docker "$normal_user"
sudo chsh -s "$(which zsh)" "$normal_user"

sudo hostnamectl set-hostname elite
if grep -q "^127.0.1.1" /etc/hosts; then
    sudo sed -i "s/^127\.0\.1\.1.*/127.0.1.1\telite/" /etc/hosts
else
    echo -e "127.0.1.1\telite" | sudo tee -a /etc/hosts > /dev/null
fi

sudo tee /etc/motd > /dev/null <<'EOF'
 ▗▄▄▖▗▖ ▗▖ ▗▄▖ ▗▄▄▄  ▗▄▖ ▗▖ ▗▖    ▗▄▄▄▖▗▖   ▗▄▄▄▖▗▄▄▄▖▗▄▄▄▖
▐▌   ▐▌ ▐▌▐▌ ▐▌▐▌  █▐▌ ▐▌▐▌ ▐▌    ▐▌   ▐▌     █    █  ▐▌
 ▝▀▚▖▐▛▀▜▌▐▛▀▜▌▐▌  █▐▌ ▐▌▐▌ ▐▌    ▐▛▀▀▘▐▌     █    █  ▐▛▀▀▘
▗▄▄▞▘▐▌ ▐▌▐▌ ▐▌▐▙▄▄▀▝▚▄▞▘▐▙█▟▌    ▐▙▄▄▖▐▙▄▄▖▗▄█▄▖  █  ▐▙▄▄▖
EOF
