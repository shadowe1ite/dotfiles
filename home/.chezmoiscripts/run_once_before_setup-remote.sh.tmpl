#!/usr/bin/env bash
set -euo pipefail

{{- define "flat" -}}
  {{- range . }}"{{ . }}" {{ end -}}
{{- end }}

if ! swapon --show | grep -q .; then
    sudo fallocate -l 4G /swapfile
    sudo chmod 600 /swapfile
    sudo mkswap /swapfile
    sudo swapon /swapfile
    echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab
fi

sudo apt update -y

{{ if eq .chezmoi.osRelease.id "ubuntu" }}
sudo apt install -y {{ template "flat" (include ".chezmoidata/packages/linux/ubuntu/ubuntu.yaml" | fromYaml).packages }}
{{ else if eq .chezmoi.osRelease.id "raspbian" }}
sudo apt install -y {{ template "flat" (include ".chezmoidata/packages/linux/rasbian/rasbian.yaml" | fromYaml).packages }}

# starship and eza aren't in Raspbian's repos. Use upstream arm-unknown-linux
# builds: that target is ARMv6, so they also run on a Pi Zero / Pi 1.
mkdir -p "$HOME/.local/bin"
if [ ! -x "$HOME/.local/bin/starship" ]; then
    curl -fsSL https://starship.rs/install.sh | sh -s -- -y -b "$HOME/.local/bin"
fi
if [ ! -x "$HOME/.local/bin/eza" ]; then
    curl -fsSL https://github.com/eza-community/eza/releases/latest/download/eza_arm-unknown-linux-gnueabihf.tar.gz |
        tar -xz -C "$HOME/.local/bin" ./eza
fi
{{ end }}

if getent group docker > /dev/null; then
    sudo usermod -aG docker "$USER"
fi

sudo chsh -s "$(which zsh)" "$USER"

sudo tee /etc/motd > /dev/null <<'EOF'

 ▗▄▄▖▗▖ ▗▖ ▗▄▖ ▗▄▄▄  ▗▄▖ ▗▖ ▗▖    ▗▄▄▄▖▗▖   ▗▄▄▄▖▗▄▄▄▖▗▄▄▄▖
▐▌   ▐▌ ▐▌▐▌ ▐▌▐▌  █▐▌ ▐▌▐▌ ▐▌    ▐▌   ▐▌     █    █  ▐▌
 ▝▀▚▖▐▛▀▜▌▐▛▀▜▌▐▌  █▐▌ ▐▌▐▌ ▐▌    ▐▛▀▀▘▐▌     █    █  ▐▛▀▀▘
▗▄▄▞▘▐▌ ▐▌▐▌ ▐▌▐▙▄▄▀▝▚▄▞▘▐▙█▟▌    ▐▙▄▄▖▐▙▄▄▖▗▄█▄▖  █  ▐▙▄▄▖


EOF
