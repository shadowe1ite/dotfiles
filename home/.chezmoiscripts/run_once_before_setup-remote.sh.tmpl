#!/usr/bin/env bash
set -euo pipefail

{{- define "flat" -}}
  {{- range . }}"{{ . }}" {{ end -}}
{{- end }}

if ! swapon --show | grep -q .; then
    sudo fallocate -l 4G /swapfile
    sudo chmod 600 /swapfile
    sudo mkswap /swapfile
    sudo swapon /swapfile
    echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab
fi

sudo apt update -y

{{ if eq .chezmoi.osRelease.id "ubuntu" }}
sudo apt install -y {{ template "flat" (include ".chezmoidata/packages/linux/ubuntu/ubuntu.yaml" | fromYaml).packages }}
{{ else if eq .chezmoi.osRelease.id "raspbian" }}
sudo apt install -y {{ template "flat" (include ".chezmoidata/packages/linux/rasbian/rasbian.yaml" | fromYaml).packages }}
{{ end }}

sudo usermod -aG docker "$USER"

sudo chsh -s "$(which zsh)" "$USER"

sudo tee /etc/motd > /dev/null <<'EOF'

 ▗▄▄▖▗▖ ▗▖ ▗▄▖ ▗▄▄▄  ▗▄▖ ▗▖ ▗▖    ▗▄▄▄▖▗▖   ▗▄▄▄▖▗▄▄▄▖▗▄▄▄▖
▐▌   ▐▌ ▐▌▐▌ ▐▌▐▌  █▐▌ ▐▌▐▌ ▐▌    ▐▌   ▐▌     █    █  ▐▌
 ▝▀▚▖▐▛▀▜▌▐▛▀▜▌▐▌  █▐▌ ▐▌▐▌ ▐▌    ▐▛▀▀▘▐▌     █    █  ▐▛▀▀▘
▗▄▄▞▘▐▌ ▐▌▐▌ ▐▌▐▙▄▄▀▝▚▄▞▘▐▙█▟▌    ▐▙▄▄▖▐▙▄▄▖▗▄█▄▖  █  ▐▙▄▄▖


EOF
