#!/usr/bin/env bash
set -euo pipefail
{{ template "utils" . }}
{{- $bwFolderId := "3bb893f4-9a06-4477-afe5-b33c00c20c5d" }}

sudoKeepAlive
checkDeps gnupg jq bitwarden-cli git pass

mkdir -p "$HOME/.config/Bitwarden CLI"
touch "$HOME/.config/Bitwarden CLI/data.json"

info "Logging in to Bitwarden"
BW_SESSION=""
BW_STATUS=$(bw status 2>/dev/null | jq -r '.status' 2>/dev/null || echo "unauthenticated")
step "Vault status: $BW_STATUS"

case "$BW_STATUS" in
  unlocked)
    # Already unlocked, but the CLI never hands back an existing session key.
    # Re-locking is the only way to get one we can pass to `bw list`.
    bw lock >/dev/null 2>&1 || true
    BW_SESSION=$(bw unlock --raw || true)
    ;;
  locked)
    for i in 1 2 3; do
      BW_SESSION=$(bw unlock --raw || true)
      [[ -n "$BW_SESSION" ]] && break
      warn "Unlock failed, retrying ($i/3)"
    done
    ;;
  *)
    for i in 1 2 3; do
      BW_SESSION=$(bw login {{ .email | quote }} --raw || true)
      [[ -n "$BW_SESSION" ]] && break
      warn "Login failed, retrying ($i/3)"
    done
    ;;
esac

[[ -n "$BW_SESSION" ]] || die "Could not obtain a Bitwarden session. Exiting."
export BW_SESSION

# chezmoi runs these scripts without a login shell, so nothing has exported
# GPG_TTY. Without it pinentry has no terminal to draw on and every passphrase
# check below fails instantly with "Inappropriate ioctl for device" — which
# looks exactly like a wrong password, three times in a row, with no prompt.
# We read the passphrase ourselves and hand it to gpg over the loopback
# pinentry, so the prompt does not depend on the agent finding a tty at all.
GPG_TTY=$(tty 2>/dev/null || true)
[[ "$GPG_TTY" == /dev/* ]] || GPG_TTY=""
export GPG_TTY

mkdir -p ~/.gnupg && chmod 700 ~/.gnupg
cat > ~/.gnupg/gpg-agent.conf <<EOF
default-cache-ttl 28800
max-cache-ttl 86400
allow-loopback-pinentry
EOF
gpg-connect-agent reloadagent /bye >/dev/null 2>&1 || true

info "Importing GPG keys"
KEYS=$(bw list items --session "$BW_SESSION" --folderid {{ $bwFolderId | quote }} \
  | jq -r '.[] | select(.notes != null) | select(.notes | contains("BEGIN PGP")) | .notes')
[[ -n "$KEYS" ]] || die "No PGP keys found in the Bitwarden folder"
if ! IMPORT_ERR=$(printf '%s\n' "$KEYS" | gpg --import --batch --yes -q 2>&1); then
  printf '%s\n' "$IMPORT_ERR" >&2
  die "gpg could not import the keys from Bitwarden"
fi

# A Bitwarden note holding only the *public* block imports cleanly and then
# fails at the first signature. Say so here instead of blaming the passphrase.
GPG_KEY=$(gpg --list-secret-keys --with-colons {{ .email | quote }} 2>/dev/null \
  | awk -F: '/^fpr:/ { print $10; exit }')
[[ -n "$GPG_KEY" ]] || die "No secret key for {{ .email }} after import — the Bitwarden note needs the PRIVATE KEY BLOCK"
step "Secret key $GPG_KEY"

info "Setting GPG key trust"
printf 'trust\n5\ny\n' | gpg --batch --command-fd 0 --edit-key "$GPG_KEY" >/dev/null 2>&1 || true

# Passphrase on fd 3, the payload to sign on stdin, so neither clobbers the
# other. Keeps the secret off the command line and out of `ps`.
gpgUnlock() {
  GPG_ERR=$(gpg -q --batch --yes --pinentry-mode loopback --passphrase-fd 3 \
    --local-user "$GPG_KEY" --sign --output /dev/null 3<<<"$1" <<<"unlock" 2>&1)
}

info "Enter GPG password"
[[ -r /dev/tty ]] || die "No terminal attached, cannot ask for the GPG passphrase"
GPG_OK=false
GPG_PASS=""
GPG_ERR=""
for i in 1 2 3; do
  printf '  │ Passphrase for %s: ' {{ .email | quote }} > /dev/tty
  IFS= read -rs GPG_PASS < /dev/tty || true
  printf '\n' > /dev/tty
  if gpgUnlock "$GPG_PASS"; then
    GPG_OK=true
    break
  fi
  warn "Wrong passphrase, try again ($i/3)"
done
if [[ "$GPG_OK" != "true" ]]; then
  [[ -n "$GPG_ERR" ]] && printf '%s\n' "$GPG_ERR" >&2
  bw logout >/dev/null 2>&1 || true
  die "GPG passphrase failed 3 times. Exiting."
fi
ok "Key unlocked"

info "Bootstrapping SSH keys"
mkdir -p ~/.ssh && chmod 700 ~/.ssh
gpg -q --batch --yes --pinentry-mode loopback --passphrase-fd 3 \
  --decrypt {{ printf "%s/private_dot_ssh/encrypted_private_id_ed25519_main.asc" .chezmoi.sourceDir | quote }} \
  > ~/.ssh/id_ed25519_main 3<<<"$GPG_PASS" \
  || die "Could not decrypt the SSH key with this GPG key"
chmod 600 ~/.ssh/id_ed25519_main
unset GPG_PASS
cat > ~/.ssh/config <<'SSHEOF'
Host main
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_main
  StrictHostKeyChecking accept-new
SSHEOF
chmod 600 ~/.ssh/config
step "SSH key deployed from chezmoi source"

info "Cloning password store"
if [[ -d ~/.password-store/.git ]]; then
  step "Already exists, pulling"
  git -C ~/.password-store pull || warn "Could not pull password store"
else
  git clone "main:shadowe1ite/.password-store.git" ~/.password-store \
    || warn "Could not clone password store (check the deploy key on GitHub)"
fi

ok "Password store ready"

info "Cleaning up"
bw logout >/dev/null 2>&1 || true
ok "GPG setup completed"
