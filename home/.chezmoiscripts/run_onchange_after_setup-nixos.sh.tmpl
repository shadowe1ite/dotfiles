{{- if eq .chezmoi.osRelease.id "nixos" -}}
#!/usr/bin/env bash
# mothership member VM (NixOS microvm). The system is rebuilt from the
# mothership repo on every boot, so only per-user state goes here:
# packages in the user's nix profile, and a bash → zsh hand-off because the
# login shell is set by mothership (chsh would not survive a restart).
# Runs after dotfiles are written; re-runs when the package list or zimrc changes.
# packages: {{ (include ".chezmoidata/packages/linux/nixos/nixos.yaml" | sha256sum) }}
# zimrc:    {{ (include "private_dot_zimrc" | sha256sum) }}
set -euo pipefail

nix() { command nix --extra-experimental-features 'nix-command flakes' "$@"; }

installed=$(nix profile list 2>/dev/null || true)
missing=()
for p in {{ range (include ".chezmoidata/packages/linux/nixos/nixos.yaml" | fromYaml).packages }}{{ . }} {{ end }}; do
    # `nix profile list` prints "Name: <pkg>" and "...legacyPackages.<system>.<pkg>"
    grep -qE "^Name:[[:space:]]+$p\$|legacyPackages\.[^.]+\.$p([[:space:]]|\$)" <<<"$installed" \
        || missing+=("nixpkgs#$p")
done
if ((${#missing[@]})); then
    nix profile add "${missing[@]}"
fi

# start zsh on SSH login (idempotent)
if ! grep -qs 'nix-profile/bin/zsh' "$HOME/.bash_profile"; then
    cat >> "$HOME/.bash_profile" <<'EOF'
if [ -t 1 ] && [ -z "$ZSH_VERSION" ] && [ -x "$HOME/.nix-profile/bin/zsh" ]; then
  export SHELL="$HOME/.nix-profile/bin/zsh"
  exec "$SHELL" -l
fi
EOF
fi

# personal tailnet: a second, userspace tailscaled next to the system one
# (system one = TinkerHub mesh, never touch it). Own state + socket under ~,
# so it can't clash. Needs `linger = true;` in user-vms/alan.nix to start at
# boot. First time only: `ts up` and open the login link.
unit_dir="$HOME/.config/systemd/user"
mkdir -p "$unit_dir"
cat > "$unit_dir/tailscaled-me.service" <<'EOF'
[Unit]
Description=Personal tailscaled (userspace, own tailnet)
After=network-online.target

[Service]
ExecStart=/run/current-system/sw/bin/tailscaled --tun=userspace-networking --statedir=%h/.local/share/tailscale-me --socket=%t/tailscale-me.sock --port=0 --socks5-server=localhost:1055 --outbound-http-proxy-listen=localhost:1055
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
EOF
if systemctl --user daemon-reload 2>/dev/null; then
    systemctl --user enable --now tailscaled-me.service || true
else
    echo "[setup-nixos] no user systemd session; run: systemctl --user enable --now tailscaled-me"
fi

# zram swap: the VM has no swap, and the system (rebuilt every boot) won't
# keep one, so a user service sets it up again on each boot via sudo -n.
# zram = compressed swap in RAM; /persist is virtiofs and can't hold a swapfile.
mkdir -p "$HOME/.local/bin"
cat > "$HOME/.local/bin/zram-swap" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
export PATH=/run/wrappers/bin:/run/current-system/sw/bin:$PATH
swapon --show | grep -q zram0 && exit 0
sudo -n modprobe zram
echo zstd | sudo -n tee /sys/block/zram0/comp_algorithm >/dev/null
echo 2G   | sudo -n tee /sys/block/zram0/disksize       >/dev/null
sudo -n mkswap -q /dev/zram0
sudo -n swapon -p 100 /dev/zram0
sudo -n sysctl -q vm.swappiness=100
EOF
chmod +x "$HOME/.local/bin/zram-swap"

cat > "$unit_dir/zram-swap.service" <<'EOF'
[Unit]
Description=zram swap (2G, zstd)

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/zram-swap

[Install]
WantedBy=default.target
EOF
if systemctl --user daemon-reload 2>/dev/null; then
    systemctl --user enable --now zram-swap.service || true
fi

# stable SSH host keys: /etc/ssh is wiped every boot, so sshd makes new keys
# and every client screams "REMOTE HOST IDENTIFICATION HAS CHANGED". First run
# saves the current keys under ~ (on /persist); every boot after puts them back.
cat > "$HOME/.local/bin/ssh-hostkeys" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
umask 077
export PATH=/run/wrappers/bin:/run/current-system/sw/bin:$PATH
store="$HOME/.local/share/ssh-hostkeys"

if [[ ! -s "$store/ssh_host_ed25519_key" ]]; then
    mkdir -p "$store"
    for f in /etc/ssh/ssh_host_*_key; do
        b=$(basename "$f")
        sudo -n cat "$f"     > "$store/$b"
        sudo -n cat "$f.pub" > "$store/$b.pub"
    done
    echo "saved host keys to $store"
    exit 0
fi

changed=0
for k in "$store"/ssh_host_*_key; do
    dst="/etc/ssh/$(basename "$k")"
    [[ "$(sha256sum < "$k")" == "$(sudo -n cat "$dst" 2>/dev/null | sha256sum)" ]] && continue
    sudo -n tee "$dst"     < "$k"     >/dev/null
    sudo -n tee "$dst.pub" < "$k.pub" >/dev/null
    sudo -n chown root:root "$dst" "$dst.pub"
    sudo -n chmod 600 "$dst"
    sudo -n chmod 644 "$dst.pub"
    changed=1
done
if ((changed)); then
    sudo -n systemctl restart sshd
    echo "restored host keys from $store"
fi
EOF
chmod +x "$HOME/.local/bin/ssh-hostkeys"

cat > "$unit_dir/ssh-hostkeys.service" <<'EOF'
[Unit]
Description=Restore saved SSH host keys

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/ssh-hostkeys

[Install]
WantedBy=default.target
EOF
if systemctl --user daemon-reload 2>/dev/null; then
    systemctl --user enable --now ssh-hostkeys.service || true
fi

# pre-install zimfw + plugins now, so the first SSH login doesn't sit silently
# downloading them (looks hung; Ctrl+C leaves a half-loaded shell)
echo "[setup-nixos] installing zsh plugins..."
TERM=xterm-256color "$HOME/.nix-profile/bin/zsh" -ic 'exit' </dev/null >/dev/null || true
{{ end -}}
