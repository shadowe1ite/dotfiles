{{- if eq .chezmoi.osRelease.id "nixos" -}}
#!/usr/bin/env bash
# mothership member VM (NixOS microvm). The system is rebuilt from the
# mothership repo on every boot, so only per-user state goes here:
# packages in the user's nix profile, and a bash → zsh hand-off because the
# login shell is set by mothership (chsh would not survive a restart).
# Runs after dotfiles are written; re-runs when the package list or zimrc changes.
# packages: {{ (include ".chezmoidata/packages/linux/nixos/nixos.yaml" | sha256sum) }}
# zimrc:    {{ (include "private_dot_zimrc" | sha256sum) }}
set -euo pipefail

nix() { command nix --extra-experimental-features 'nix-command flakes' "$@"; }

installed=$(nix profile list 2>/dev/null || true)
missing=()
for p in {{ range (include ".chezmoidata/packages/linux/nixos/nixos.yaml" | fromYaml).packages }}{{ . }} {{ end }}; do
    # `nix profile list` prints "Name: <pkg>" and "...legacyPackages.<system>.<pkg>"
    grep -qE "^Name:[[:space:]]+$p\$|legacyPackages\.[^.]+\.$p([[:space:]]|\$)" <<<"$installed" \
        || missing+=("nixpkgs#$p")
done
if ((${#missing[@]})); then
    # --impure + NIXPKGS_ALLOW_UNFREE: brave is unfree in nixpkgs
    NIXPKGS_ALLOW_UNFREE=1 nix profile add --impure "${missing[@]}"
fi

# start zsh on SSH login (idempotent)
if ! grep -qs 'nix-profile/bin/zsh' "$HOME/.bash_profile"; then
    cat >> "$HOME/.bash_profile" <<'EOF'
if [ -t 1 ] && [ -z "$ZSH_VERSION" ] && [ -x "$HOME/.nix-profile/bin/zsh" ]; then
  export SHELL="$HOME/.nix-profile/bin/zsh"
  exec "$SHELL" -l
fi
EOF
fi

# personal tailnet: a second, userspace tailscaled next to the system one
# (system one = TinkerHub mesh, never touch it). Own state + socket under ~,
# so it can't clash. Needs `linger = true;` in user-vms/alan.nix to start at
# boot. First time only: `ts up` and open the login link.
unit_dir="$HOME/.config/systemd/user"
mkdir -p "$unit_dir"
cat > "$unit_dir/tailscaled-me.service" <<'EOF'
[Unit]
Description=Personal tailscaled (userspace, own tailnet)
After=network-online.target

[Service]
ExecStart=/run/current-system/sw/bin/tailscaled --tun=userspace-networking --statedir=%h/.local/share/tailscale-me --socket=%t/tailscale-me.sock --port=0 --socks5-server=localhost:1055 --outbound-http-proxy-listen=localhost:1055
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
EOF
if systemctl --user daemon-reload 2>/dev/null; then
    systemctl --user enable --now tailscaled-me.service || true
else
    echo "[setup-nixos] no user systemd session; run: systemctl --user enable --now tailscaled-me"
fi

# pre-install zimfw + plugins now, so the first SSH login doesn't sit silently
# downloading them (looks hung; Ctrl+C leaves a half-loaded shell)
echo "[setup-nixos] installing zsh plugins..."
TERM=xterm-256color "$HOME/.nix-profile/bin/zsh" -ic 'exit' </dev/null >/dev/null || true
{{ end -}}
