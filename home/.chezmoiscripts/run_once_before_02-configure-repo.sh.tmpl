#!/usr/bin/env bash
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/.chezmoiscripts/.lib/util.sh"

export PATH="$HOME/.local/bin:$PATH"

{{- if ne .chezmoi.osRelease.id "cachyos" }}
if [[ -f /etc/pacman.conf.bak ]]; then
  warn "pacman.conf.bak exists. Skipping rewrite."
  exit 0
fi
{{- end }}

info "Setting:q up repositories"
sudo cp /etc/pacman.conf /etc/pacman.conf.bak

if [[ ! -f "$HOME/.config/paru/paru.conf" ]]; then
  mkdir -p "$HOME/.config/paru"
  curl -fsSL "https://raw.githubusercontent.com/shadowe1ite/dotfiles/refs/heads/main/home/dot_config/paru/paru.conf" \
    -o "$HOME/.config/paru/paru.conf"
fi

paru -Sya --noconfirm >/dev/null 2>&1
sudo pacman-key --init
sudo pacman-key --populate archlinux

if [[ ! -f /etc/pacman.d/chaotic-mirrorlist ]]; then
  repoKeys "Chaotic" "3056513887B78AEB"
  step "Installing Chaotic packages"
  sudo pacman -U --noconfirm \
    'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' \
    'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst'
  ok "Chaotic repo installed"
else
  warn "Chaotic repo already present"
fi

if [[ ! -f /etc/pacman.d/blackarch-mirrorlist ]]; then
  step "Installing BlackArch keyring"
  bash -c '
    VERSION=$(curl -s https://www.blackarch.org/keyring/ | grep -oP "blackarch-keyring-\K[0-9]+" | head -n1)
    TD=$(mktemp -d); trap "rm -rf $TD" EXIT; cd "$TD"
    curl -s -O "https://www.blackarch.org/keyring/blackarch-keyring-$VERSION.tar.gz"
    sudo tar xfz "blackarch-keyring-$VERSION.tar.gz" --strip-components=1 -C /usr/share/pacman/keyrings/
    sudo pacman-key --populate
  '
  sudo curl -fsSL https://blackarch.org/blackarch-mirrorlist -o /etc/pacman.d/blackarch-mirrorlist
  [[ -f /etc/pacman.d/blackarch-mirrorlist.pacnew ]] && sudo mv /etc/pacman.d/blackarch-mirrorlist.pacnew /etc/pacman.d/blackarch-mirrorlist
  ok "BlackArch repo installed"
else
  warn "BlackArch repo already present"
fi

sudo tee /etc/pacman.conf > /dev/null <<'EOF'
{{ includeTemplate "pacman.conf.tmpl" . }}
EOF

sudo pacman -Syy --noconfirm >/dev/null 2>&1
sudo pacman -S --noconfirm --needed blackarch-mirrorlist >/dev/null 2>&1

ok "Done. Backup at /etc/pacman.conf.bak"
