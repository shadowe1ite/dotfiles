#!/usr/bin/env bash
set -euo pipefail
{{ template "utils" . }}

STORAGE="{{ .storage | default "/mnt/storage" }}"

set -euo pipefail

mkdir -p "$HOME"/{Videos/Captures/Clips,Music/Clips,Pictures/Screenshots}
rm -rf "$HOME/Documents"
ln -sfn "$STORAGE/Documents" "$HOME/Documents"
ln -sfn "$STORAGE/Movies" "$HOME/Videos/Movies"
ln -sfn "$STORAGE/Music" "$HOME/Music"
ln -sfn "$STORAGE/courses" "$HOME/Videos/courses"
ln -sfn "$STORAGE/wall" "$HOME/Pictures/Wallpapers"
ln -sfn "$STORAGE/code" "$HOME/code"

xdg-user-dirs-update
ok "Directories setup complete"

{{ if eq .chezmoi.username .user }}
{{ if eq .chezmoi.osRelease.id "arch" }}

if [[ "$SHELL" != "$(which zsh)" ]]; then
  zsh -c 'source ~/.zshrc'
  info "Changing shell to zsh"
  sudo chsh -s "$(which zsh)" "$USER"
fi

sudo systemctl disable iwd.service
sudo systemctl disable systemd-networkd.service

if command -v warp-cli >/dev/null 2>&1; then
    if ! warp-cli registration show 2>/dev/null | grep -q "Account type"; then
        echo "Registering warp..."
        echo 'y' | warp-cli registration new
    else
        echo "Warp already registered, skipping..."
    fi

    warp-cli connect
else
    echo "warp-cli is not installed. Skipping..."
fi

ok "Installation completed"

notify "⚙️ All Done 🎉. Now reboot your system"

if confirm "Reboot now?"; then
  reboot
else
  info "Reboot skipped"
fi

{{ end }}
{{ end }}
