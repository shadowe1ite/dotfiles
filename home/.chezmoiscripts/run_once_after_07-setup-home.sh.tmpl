#!/usr/bin/env bash
set -euo pipefail

{{- $chassis := includeTemplate "sys-chassis.tmpl" . }}
{{ template "utils" . }}

STORAGE="{{ .storage | default "/mnt/storage" }}"

set -euo pipefail

mkdir -p "$HOME"/{Videos/Captures/Clips,Music/Clips,Pictures/Screenshots}
rm -rf "$HOME/Documents"
ln -sf "$STORAGE/Documents"  "$HOME/Documents"
ln -sf "$STORAGE/Movies"     "$HOME/Videos/Movies"
ln -sf "$STORAGE/Music"      "$HOME/Music"
ln -sf "$STORAGE/courses"    "$HOME/Videos/courses"
ln -sf "$STORAGE/wall"       "$HOME/Pictures/Wallpapers"
ln -sf "$STORAGE/code"       "$HOME/code"

xdg-user-dirs-update
ok "Directories setup complete"

{{- if eq .chezmoi.username .user }}


{{ if eq .chezmoi.osRelease.id "arch" -}}
sudo systemctl disable iwd.service || true
sudo systemctl disable systemd-networkd.service || true
nmcli dev wifi connect "{{ pass "desktop/wifi-name" }}" password "{{ pass "desktop/wifi-pass" }}" || true
{{ end -}}

sudo virsh net-autostart default || true
sudo virsh net-start default || true

echo 'y' | warp-cli registration new || true
warp-cli connect || true

ok "Installation completed"

notify "⚙️ All Done 🎉. Now reboot your system"

if confirm "Reboot now?"; then
  reboot
else
  info "Reboot skipped"
fi
{{- end }}
