#!/usr/bin/env bash
set -euo pipefail

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  export XDG_RUNTIME_DIR=/run/user/$(id -u)
fi
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
  export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
fi

{{ template "utils" . }}

USER_SERVICES=(
{{- with .services }}{{- with .user }}{{- range . }}"{{ . }}" {{ end }}{{- end }}{{- end -}}
)

SYSTEM_SERVICES=(
{{- with .services }}{{- with .system }}{{- range . }}"{{ . }}" {{ end }}{{- end }}{{- end -}}
)

sudoKeepAlive

# Without a user systemd instance (no logind session on this tty) every
# `systemctl --user` call fails; say so once instead of 9 identical errors.
if systemctl --user is-system-running &>/dev/null || [[ -S "$XDG_RUNTIME_DIR/systemd/private" ]]; then
  info "User services (${#USER_SERVICES[@]})"
  for s in "${USER_SERVICES[@]}"; do enableSvc "$s" "user"; done
else
  warn "No user systemd instance on this session; skipping ${#USER_SERVICES[@]} user services"
  warn "Re-run after logging in graphically: chezmoi state delete-bucket --bucket=scriptState && chezmoi apply"
fi

info "System services (${#SYSTEM_SERVICES[@]})"
for s in "${SYSTEM_SERVICES[@]}"; do enableSvc "$s" "system"; done

info "Groups"
{{ range .groups -}}
if getent group {{ . | quote }} >/dev/null 2>&1; then
  if id -nG "$(id -un)" | tr ' ' '\n' | grep -qx {{ . | quote }}; then
    step "already in group: {{ . }}"
  else
    sudo usermod -aG {{ . | quote }} "$(id -un)" && step "added to group: {{ . }}" \
      || warn "Could not add $(id -un) to group {{ . }}"
  fi
else
  warn "Group {{ . }} does not exist (package not installed?), skipping"
fi
{{ end }}
# mask autostart
systemctl --user mask xdg-desktop-autostart.target &>/dev/null \
  || warn "Could not mask xdg-desktop-autostart.target"

ok "Finished services and groups"
