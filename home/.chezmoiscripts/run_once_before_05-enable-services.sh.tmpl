#!/usr/bin/env bash
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/.chezmoiscripts/.lib/util.sh"

USER_SERVICES=(
{{- with .services }}{{- with .user }}{{- range . }}"{{ . }}" {{ end }}{{- end }}{{- end -}}
)

SYSTEM_SERVICES=(
{{- with .services }}{{- with .system }}{{- range . }}"{{ . }}" {{ end }}{{- end }}{{- end -}}
)

info "User services (${#USER_SERVICES[@]})"
for s in "${USER_SERVICES[@]}"; do enableSvc "$s" "user"; done

info "System services (${#SYSTEM_SERVICES[@]})"
for s in "${SYSTEM_SERVICES[@]}"; do enableSvc "$s" "system"; done

{{ range .groups -}}
sudo usermod -aG {{ . }} "$USER"
{{ end -}}

ok "Finished services and groups"
