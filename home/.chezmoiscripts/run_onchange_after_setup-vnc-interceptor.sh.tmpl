{{- if eq .chezmoi.osRelease.id "nixos" -}}
#!/usr/bin/env bash
# mothership VM: Interceptor in Chromium on a virtual desktop, viewable in a web browser.
#
#   Xvnc :1 (localhost:5901, no password) → openbox → chromium --load-extension=Interceptor
#   noVNC on 127.0.0.1:6080 → open http://neo:6080/vnc.html over the personal tailnet
#   (userspace tailscaled forwards tailnet connections to the VM's localhost)
#
# Runs after setup-nixos.sh (alphabetical), which installs the packages.
# Interceptor's CLI + daemon are prebuilt glibc binaries; NixOS can't run them directly
# (no nixLd), so both run through steam-run wrappers.
# Bump INTERCEPTOR_VERSION to upgrade (re-runs this script).
set -euo pipefail

INTERCEPTOR_VERSION="2.1.15"
REPO="Hacker-Valley-Media/Interceptor"
APP="$HOME/.local/share/interceptor-app"
PKG="Interceptor-Browser-$INTERCEPTOR_VERSION-linux-x64"
BIN="$HOME/.local/bin"
UNITS="$HOME/.config/systemd/user"
CHROMIUM_CFG="$HOME/.config/chromium"

say() { echo "[setup-vnc-interceptor] $*"; }

# 1. Interceptor release (checksum-verified), stable path via `current`
if [[ ! -d "$APP/$PKG" ]]; then
    say "downloading Interceptor $INTERCEPTOR_VERSION"
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    base="https://github.com/$REPO/releases/download/v$INTERCEPTOR_VERSION"
    curl -fsSL -o "$tmp/$PKG.tar.gz" "$base/$PKG.tar.gz"
    curl -fsSL -o "$tmp/SHA256SUMS"   "$base/SHA256SUMS"
    (cd "$tmp" && grep " $PKG.tar.gz\$" SHA256SUMS | sha256sum --check --quiet)
    mkdir -p "$APP"
    tar -xzf "$tmp/$PKG.tar.gz" -C "$APP"
fi
ln -sfn "$APP/$PKG" "$APP/current"

# 2. steam-run wrappers (CLI for omp/you, daemon for the browser)
mkdir -p "$BIN"
rm -f "$BIN/interceptor" "$BIN/interceptor-daemon-wrap" "$BIN/interceptor-wrap"
cat > "$BIN/interceptor" <<EOF
#!/usr/bin/env bash
exec "\$HOME/.nix-profile/bin/steam-run" "$APP/current/dist/interceptor" "\$@"
EOF
cat > "$BIN/interceptor-daemon" <<EOF
#!/usr/bin/env bash
exec "\$HOME/.nix-profile/bin/steam-run" "$APP/current/daemon/interceptor-daemon" "\$@"
EOF
chmod +x "$BIN/interceptor" "$BIN/interceptor-daemon"

# 3. native messaging host: lets the extension start the daemon
mkdir -p "$CHROMIUM_CFG/NativeMessagingHosts"
sed "s|__DAEMON_PATH__|$BIN/interceptor-daemon|" \
    "$APP/current/daemon/com.interceptor.host.json" \
    > "$CHROMIUM_CFG/NativeMessagingHosts/com.interceptor.host.json"

# 4. Chromium drops --load-extension unless Developer mode is on: force it
#    before every browser start (browser is stopped at that point)
cat > "$APP/devmode.py" <<'EOF'
import json, os, sys
p = sys.argv[1]
os.makedirs(os.path.dirname(p), exist_ok=True)
try:
    d = json.load(open(p))
except Exception:
    d = {}
d.setdefault("extensions", {}).setdefault("ui", {})["developer_mode"] = True
json.dump(d, open(p, "w"))
EOF

# 5. user services
mkdir -p "$UNITS"
rm -f "$UNITS/brave-interceptor.service"
cat > "$UNITS/vnc.service" <<'EOF'
[Unit]
Description=Xvnc virtual display :1 (localhost:5901 only, no password)

[Service]
ExecStart=%h/.nix-profile/bin/Xvnc :1 -geometry 1600x900 -depth 24 -localhost -rfbport 5901 -SecurityTypes None -AlwaysShared
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
EOF

cat > "$UNITS/vnc-openbox.service" <<'EOF'
[Unit]
Description=openbox on :1
Requires=vnc.service
After=vnc.service
PartOf=vnc.service

[Service]
Environment=DISPLAY=:1
ExecStart=%h/.nix-profile/bin/openbox
# X may not be up yet on first try: just retry
Restart=on-failure
RestartSec=1

[Install]
WantedBy=vnc.service
EOF

cat > "$UNITS/chromium-interceptor.service" <<'EOF'
[Unit]
Description=Chromium + Interceptor extension on :1
Requires=vnc.service
After=vnc.service vnc-openbox.service
PartOf=vnc.service

[Service]
Environment=DISPLAY=:1
ExecStartPre=%h/.nix-profile/bin/python3 %h/.local/share/interceptor-app/devmode.py %h/.config/chromium/Default/Preferences
ExecStart=%h/.nix-profile/bin/chromium --load-extension=%h/.local/share/interceptor-app/current/extension/dist --disable-features=DisableLoadExtensionCommandLineSwitch --no-first-run --no-default-browser-check --password-store=basic --disable-gpu
Restart=on-failure
RestartSec=2

[Install]
WantedBy=vnc.service
EOF

cat > "$UNITS/novnc.service" <<'EOF'
[Unit]
Description=noVNC web view of :1 (http://neo:6080/vnc.html)
Requires=vnc.service
After=vnc.service
PartOf=vnc.service

[Service]
ExecStart=%h/.nix-profile/bin/novnc --vnc localhost:5901 --listen 127.0.0.1:6080
Restart=on-failure
RestartSec=2

[Install]
WantedBy=vnc.service
EOF

if ! systemctl --user daemon-reload 2>/dev/null; then
    say "no user systemd session; later run: systemctl --user enable --now vnc vnc-openbox chromium-interceptor novnc"
    exit 0
fi
systemctl --user disable brave-interceptor.service 2>/dev/null || true
systemctl --user enable vnc.service vnc-openbox.service chromium-interceptor.service novnc.service
systemctl --user restart vnc.service vnc-openbox.service chromium-interceptor.service novnc.service || true
say "running: open http://neo:6080/vnc.html  (check: interceptor init --verbose)"
{{ end -}}
