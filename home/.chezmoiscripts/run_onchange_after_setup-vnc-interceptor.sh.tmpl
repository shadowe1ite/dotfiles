{{- if eq .chezmoi.osRelease.id "nixos" -}}
#!/usr/bin/env bash
# Interceptor in Chromium on a virtual desktop. Start it with `desk` (in tmux),
# then open http://neo:6080/vnc.html
set -euo pipefail

INTERCEPTOR_VERSION="2.1.15"
REPO="Hacker-Valley-Media/Interceptor"
APP="$HOME/.local/share/interceptor-app"
PKG="Interceptor-Browser-$INTERCEPTOR_VERSION-linux-x64"
BIN="$HOME/.local/bin"

if [[ ! -d "$APP/$PKG" ]]; then
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    base="https://github.com/$REPO/releases/download/v$INTERCEPTOR_VERSION"
    curl -fsSL -o "$tmp/$PKG.tar.gz" "$base/$PKG.tar.gz"
    curl -fsSL -o "$tmp/SHA256SUMS"   "$base/SHA256SUMS"
    (cd "$tmp" && grep " $PKG.tar.gz\$" SHA256SUMS | sha256sum --check --quiet)
    mkdir -p "$APP"
    tar -xzf "$tmp/$PKG.tar.gz" -C "$APP"
fi
ln -sfn "$APP/$PKG" "$APP/current"

mkdir -p "$BIN"
ln -sf "$APP/current/dist/interceptor" "$BIN/interceptor"

mkdir -p "$HOME/.config/chromium/NativeMessagingHosts"
sed "s|__DAEMON_PATH__|$APP/current/daemon/interceptor-daemon|" \
    "$APP/current/daemon/com.interceptor.host.json" \
    > "$HOME/.config/chromium/NativeMessagingHosts/com.interceptor.host.json"

# Chromium ignores --load-extension unless Developer mode is on
cat > "$APP/devmode.py" <<'EOF'
import json, os, sys
p = sys.argv[1]
os.makedirs(os.path.dirname(p), exist_ok=True)
try:
    d = json.load(open(p))
except Exception:
    d = {}
d.setdefault("extensions", {}).setdefault("ui", {})["developer_mode"] = True
json.dump(d, open(p, "w"))
EOF

cat > "$BIN/desk" <<'EOF'
#!/usr/bin/env bash
export DISPLAY=:1
APP="$HOME/.local/share/interceptor-app"

# dark everywhere on this bare openbox session (no DE / portal to ask):
# GTK3 apps get Adwaita dark, Qt apps take their colours from GTK
export GTK_THEME=Adwaita:dark
export QT_QPA_PLATFORMTHEME=gtk3

Xvnc :1 -geometry 1600x900 -depth 24 -localhost -SecurityTypes None -AlwaysShared &
XVNC=$!
trap 'kill $XVNC 2>/dev/null; pkill -f "openbox|chromium" 2>/dev/null' EXIT
sleep 2

openbox &
python3 "$APP/devmode.py" "$HOME/.config/chromium/Default/Preferences"
chromium --load-extension="$APP/current/extension/dist" \
    --disable-features=DisableLoadExtensionCommandLineSwitch \
    --no-first-run --no-default-browser-check --password-store=basic --disable-gpu \
    --force-dark-mode &

novnc --vnc localhost:5901 --listen 127.0.0.1:6080
EOF
chmod +x "$BIN/desk"
{{ end -}}
