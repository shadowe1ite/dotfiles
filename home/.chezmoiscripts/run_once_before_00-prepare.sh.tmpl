#!/usr/bin/env bash
set -euo pipefail
{{ template "utils" . }}

info "Preparing installation"

sudoKeepAlive

step "Refreshing keyring and build tools"
# One transaction. `pacman -Sy` followed by a separate `-S` is a partial
# upgrade: it desyncs the local db from the mirrors and is the classic way to
# break a fresh Arch box before it has installed anything.
sudo pacman -Syu --needed --noconfirm archlinux-keyring git curl openssh base-devel

if ! have "$AUR"; then
  step "Building $AUR"
  tmpdir=$(mktemp -d)
  trap 'rm -rf "$tmpdir"; kill "${SUDO_KEEPALIVE_PID:-}" 2>/dev/null || true' EXIT
  git clone --depth 1 "https://aur.archlinux.org/${AUR}-bin.git" "$tmpdir"
  ( cd "$tmpdir" && makepkg -si --noconfirm )
  have "$AUR" || die "$AUR still not on PATH after building ${AUR}-bin"
fi

step "Upgrading system (this can take a while)"
$AUR -Syu --noconfirm

ok "Preparation complete"
