[user]
	email = {{ .email}}
	name = {{ .name}}
  signingkey = {{ .email}}

[credential]
	helper = store

[core]
	editor = nvim

[commit]
	gpgsign = true

[github]
	signingkey = {{ .email}}

[url "main:"]
    pushInsteadOf = https://github.com/

[url "gitlab:"]
    pushInsteadOf = https://gitlab.com/
