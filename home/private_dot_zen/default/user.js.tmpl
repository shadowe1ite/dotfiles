// bookmarks
{{- if eq .chezmoi.username .user }}
user_pref("browser.bookmarks.file", "{{ (joinPath .chezmoi.homeDir ".zen" .home.zen.release_path "bookmarks.html" ) | js }}");
user_pref("browser.places.importBookmarksHTML", true);
user_pref("browser.bookmarks.autoExportHTML", true);
{{ end }}
user_pref("browser.bookmarks.restore_default_bookmarks", false);
user_pref("browser.toolbars.bookmarks.visibility", "always");

// lean 
user_pref("mod.lean.bookmarks", true);

// bring old zen new tab
user_pref("zen.urlbar.replace-newtab", false);

{{- if eq .chezmoi.username .user }}
// allow local traffic via proxy
user_pref("network.proxy.allow_hijacking_localhost", true);
{{ end }}

// disable welcome screen
user_pref("zen.welcome-screen.seen", true);

// startup page
user_pref("browser.startup.homepage", "about:home");
user_pref("browser.newtabpage.enabled", true);
user_pref("browser.newtabpage.activity-stream.showSearch", true);
user_pref("browser.startup.homepage_override.mstone", "ignore");

// ask download location 
user_pref("browser.download.useDownloadDir", false);

// enable compact mode
user_pref("zen.view.sidebar-expanded.on-hover", true);
user_pref("sidebar.visibility", "hide-sidebar");
user_pref("zen.view.use-single-toolbar", false);
user_pref("zen.view.compact.enable-at-startup", true);

// auto reload essential tabs 
user_pref("browser.sessionstore.restore_pinned_tabs_on_demand", true);
user_pref("zen.pinned-tab-manager.restore-pinned-tabs-to-pinned-url", true);

// UI
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
// user_pref("ui.systemUsesDarkTheme", 1); // disabled currently

