#!/bin/sh
# neo: fake xclip that only reads (-o), from the laptop clipboard via ssh RemoteForward 19988 (clipserve)
out=0 t=text/plain
while [ $# -gt 0 ]; do
  case $1 in -o|-out) out=1 ;; -t|-target) t=$2; shift ;; esac
  shift
done
[ "$out" = 1 ] || exit 1
[ "$t" = TARGETS ] && p=targets || p="type/$t"
exec curl -sf --noproxy '*' -m 5 "http://127.0.0.1:19988/$p"
