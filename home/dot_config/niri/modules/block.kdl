window-rule {
    match title=r#"(?i).*\b(youtube|gemini|chatgpt|gmail|hotstar|netflix|login|my account|register|sign up|sign in) — Zen Browser.*"#
    match title="/home/.*/Videos.* — Dolphin"
    match title="/home/.*/Documents.* — Dolphin"
    match title="/home/.*/Downloads.* — Dolphin"
    match title="trash:/ — Dolphin"
    block-out-from "screencast"
}

window-rule {
    match app-id="mpv"
    block-out-from "screencast"
}
