//prefer-no-csd

screenshot-path null

overview {
    zoom 0.5
    backdrop-color "#262626"

    workspace-shadow {
        softness 40
        spread 10
        offset x=0 y=10
        color "#00000050"
    }
}

recent-windows {
    highlight {
      corner-radius 0
    }
}

hotkey-overlay {
    skip-at-startup
}
