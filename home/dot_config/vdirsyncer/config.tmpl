[general]
status_path = "~/.vdirsyncer/status/"

[pair calendar]
a = "google_calendar"
b = "local_calendar"
collections = ["from a", "from b"]
metadata = ["color"]

[storage local_calendar]
type = "filesystem"
path = "~/.calendars/"
fileext = ".ics"

[storage google_calendar]
type = "google_calendar"
token_file = "~/.vdirsyncer/google_token"
client_id = "{{ pass "calendar/client" }}"
client_secret = "{{ pass "calendar/secret" }}"
