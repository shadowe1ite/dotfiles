{{- $EndId := "end-4" -}}
{{- $EndBranch := "main" -}}

{{ if or (eq .chezmoi.osRelease.id "raspbian") (eq .chezmoi.osRelease.id "ubuntu") }}

#[".config/quickshell/noctalia-shell"]
#type = "git-repo"
#url = "https://github.com/noctalia-dev/noctalia-shell"
