{{ $archMap := dict "amd64" "x86_64" "arm64" "aarch64" "386" "i686" }}
{{ $processor := get $archMap .chezmoi.arch | default .chezmoi.arch }}

{{ if and (eq .chezmoi.os "linux") (has .chezmoi.arch (list "amd64" "arm64")) }}
{{ $caidoVersion := (gitHubLatestRelease "caido/caido").TagName | toString }}
[".local/bin/caido"]
type = "file"
url = {{ printf "https://caido.download/releases/%s/caido-desktop-%s-linux-%s.AppImage" $caidoVersion $caidoVersion $processor | quote }}
executable = true

[".local/bin/caido-cli"]
type = "archive-file"
url = {{ printf "https://caido.download/releases/%s/caido-cli-%s-linux-%s.tar.gz" $caidoVersion $caidoVersion $processor | quote }}
path = "./caido-cli"
executable = true
{{ end }}

{{ if and (ne .chezmoi.osRelease.id "raspbian") (ne .chezmoi.osRelease.id "ubuntu") }}
[".local/share/fonts"]
type = "archive"
url = "https://smc.org.in/downloads/fonts/raghumalayalamsans/raghumalayalamsans.zip"
include = ["*.otf", "*.ttf"]
refreshPeriod = "744h"

[".local/share/icons/Bibata-Modern-Ice"]
type = "archive"
url = "https://github.com/rtgiskard/bibata_cursor/releases/latest/download/Bibata-Modern-Ice.hypr.tar.zst"
refreshPeriod = "744h"
stripComponents = 1

[".local/share/icons/Bibata-Modern-Ice/"]
type = "archive"
url = "https://github.com/ful1e5/Bibata_Cursor/releases/latest/download/Bibata-Modern-Ice.tar.xz"
include = ["*/**"]
refreshPeriod = "744h"
stripComponents = 1

[".config/gf"]
type = "git-repo"
url = "https://github.com/shadowe1ite/GFpattren"
refreshPeriod = "168h"

[".local/bin/cloudflared"]
type = "file"
url = {{ gitHubLatestReleaseAssetURL "cloudflare/cloudflared" (printf "cloudflared-%s-%s" .chezmoi.os .chezmoi.arch) | quote }}
executable = true
{{ end }}

{{ if eq .chezmoi.osRelease.id "ubuntu" }}
[".local/bin/fzf"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "junegunn/fzf" (printf "fzf-*-%s_%s.tar.gz" .chezmoi.os .chezmoi.arch) | quote }}
executable = true
path = "fzf"

[".local/bin/starship"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "starship/starship" (printf "starship-%s-*-%s-*.tar.gz" $processor .chezmoi.os) | quote }}
executable = true
path = "starship"

[".local/bin/nvim"]
type = "file"
url = {{ gitHubLatestReleaseAssetURL "neovim/neovim" (printf "nvim-linux-%s.appimage" $processor) | quote }}
executable = true

[".local/bin/zola"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "getzola/zola" (printf "zola-*-%s-*%s*.tar.gz" $processor .chezmoi.os) | quote }}
executable = true
path = "zola"
{{ end }}
